// npx prisma migrate dev --name init -> sync database
// npx prisma db push -> sync database
// npx prisma studio -> view database
// npx prisma generate -> generate prisma client

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// enums

enum Role {
  DEV
  STUDENT
  INSTRUCTOR
  CONTENT_MANAGER
  ADMIN
}

enum Status {
  ACTIVE
  INACTIVE
  DRAFT
  PUBLISHED

  // attempts
  INTRO
  IN_PROGRESS
  COMPLETE
  ABANDONED
}

enum SyncStatus {
  PENDING
  SYNCED
  SAVED
  ERROR
  DELETED
}

enum CategoryType {
  BLOG
  PRODUCT
}

// models

model Profile {
  id         String  @id
  email      String
  userName   String? @map("user_name")
  firstName  String? @map("first_name")
  lastName   String? @map("last_name")
  bio        String?
  avatar     String?
  phone      String?
  customized Boolean @default(false)
  role       Role    @default(STUDENT)

  srpl     Srpl?
  posts    Post[]
  comments Comment[]
  replies  Reply[]
  // emails   Email[]
  attempts Attempt[]

  syncStatus SyncStatus @default(SYNCED) @map("sync_status")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([email])
  @@map("profiles")
}

model Srpl {
  id         String @id @default(uuid())
  srplNumber String @map("srpl_number")

  profile   Profile? @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId String?  @unique @map("profile_id")

  status     Status     @default(ACTIVE)
  syncStatus SyncStatus @default(SYNCED) @map("sync_status")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([srplNumber])
  @@map(name: "srpls")
}

model Post {
  id            String  @id @default(uuid())
  image         String
  title         String
  excerpt       String
  content       String
  allowComments Boolean @default(true) @map("allow_comments")
  viewCount     Int     @default(0) @map("view_count")

  profile    Profile?  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId  String?   @unique @map("profile_id")
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId String?   @map("category_id")

  comments Comment[]

  status     Status     @default(ACTIVE)
  syncStatus SyncStatus @default(SYNCED) @map("sync_status")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([profileId, title])
  @@map(name: "posts")
}

model Category {
  id    String       @id @default(uuid())
  title String
  type  CategoryType @default(BLOG)

  posts Post[]
  // emails Email[]

  status     Status     @default(ACTIVE)
  syncStatus SyncStatus @default(SYNCED) @map("sync_status")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([title])
  @@map(name: "categories")
}

model Comment {
  id        String  @id @default(uuid())
  name      String?
  content   String
  commentId String? @map("comment_id")

  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String   @map("post_id")
  profile   Profile? @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId String?  @map("profile_id")

  replies Reply[]

  status     Status     @default(ACTIVE)
  syncStatus SyncStatus @default(SYNCED) @map("sync_status")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([name, content, postId, profileId])
  @@map(name: "comments")
}

model Reply {
  id      String  @id @default(uuid())
  name    String?
  content String

  replyId   String?  @map("reply_id")
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  commentId String?  @map("comment_id")
  profile   Profile? @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId String?  @map("profile_id")

  status     Status     @default(ACTIVE)
  syncStatus SyncStatus @default(SYNCED) @map("sync_status")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([name, content, replyId, commentId, profileId])
  @@map(name: "replies")
}

model Student {
  id       String @id @default(uuid())
  name     String
  position String
  image    String
  quote    String

  status     Status     @default(ACTIVE)
  syncStatus SyncStatus @default(SYNCED) @map("sync_status")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([quote])
  @@map(name: "students")
}

model AlumniChallenger {
  id           String @id @default(uuid())
  srpl         String
  fname        String
  lname        String
  email        String
  phone        String
  answerOption String @map("answer_option")

  status     Status     @default(ACTIVE)
  syncStatus SyncStatus @default(SYNCED) @map("sync_status")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([srpl])
  @@map(name: "alumni_challengers")
}

