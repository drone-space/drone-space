{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "generate": {
      "cache": true,
      "env": ["DATABASE_URL", "DIRECT_URL"]
    },
    "migrate:dev": {
      "cache": false,
      "env": ["DATABASE_URL", "DIRECT_URL"]
    },
    "build": {
      "dependsOn": ["^build", "@repo/db#generate"],
      "env": [
        "TURBO_TELEMETRY_DISABLED=1",

        "NODE_ENV",

        "DATABASE_URL",
        "DIRECT_URL",

        "NEXT_PUBLIC_HOST_API_DEV",
        "NEXT_PUBLIC_HOST_WEB_DEV",
        "NEXT_PUBLIC_HOST_LEARN_DEV",
        "NEXT_PUBLIC_HOST_API_PROD",
        "NEXT_PUBLIC_HOST_WEB_PROD",
        "NEXT_PUBLIC_HOST_LEARN_PROD",

        "NEXT_PUBLIC_HOST_AI_CONFERENCE",

        "NEXT_PUBLIC_EMAIL_DELIVERY",
        "NEXT_PUBLIC_EMAIL_NOREPLY",
        "NEXT_PUBLIC_EMAIL_DEV",
        "NEXT_PUBLIC_EMAIL_INFO",
        "NEXT_PUBLIC_EMAIL_INQUIRY",
        "NEXT_PUBLIC_EMAIL_TRAINING",
        "NEXT_PUBLIC_EMAIL_TONY",
        "NEXT_PUBLIC_EMAIL_TECHNICAL",

        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY",

        "NEXT_RESEND_AUDIENCE_ID_GENERAL",
        "NEXT_RESEND_KEY_GENERAL",
        "NEXT_RESEND_KEY_AUTH",
        "NEXT_RESEND_EMAIL",

        "NEXT_ANTHROPIC_MODEL_NAME",
        "NEXT_ANTHROPIC_API_KEY",

        "NEXT_PUBLIC_OPENAI_MODEL_NAME",
        "NEXT_OPENAI_API_KEY",

        "NEXT_TTS_API_KEY",
        "NEXT_TTS_VOICE_ID",
        "NEXT_TTS_MODEL_ID",

        "NEXT_PUBLIC_GA_MEASUREMENT_ID",

        "NEXT_PUBLIC_IMAGEKIT_URL"
      ],
      "outputs": ["dist/**", ".next/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types", "@repo/db#generate"]
    }
  }
}
